# LegacyCompass Environment Variables Template
# Copy this file to .env and add your real API keys

# Application
VITE_APP_NAME=LegacyCompass
VITE_APP_VERSION=1.0.0

# AI Configuration
VITE_USE_REAL_AI=true
GROQ_API_KEY=your-groq-api-key-here

# News API (GNews)
GNEWS_API_KEY=your-gnews-api-key-here

# API Configuration (when backend is ready)
VITE_API_URL=http://localhost:3000/api
VITE_API_TIMEOUT=30000

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_TRACKING=false
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_DEBUG_MODE=true

# Performance
VITE_VIRTUAL_SCROLL_THRESHOLD=500
VITE_CACHE_MAX_SIZE=5000
VITE_REQUEST_QUEUE_SIZE=20

# Security
VITE_ENABLE_CSP=true
VITE_ENABLE_RATE_LIMITING=true
